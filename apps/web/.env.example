# Copy to .env.local in this folder (never commit .env.local).

# Until sign-in exists (CS455-17), `npm run dev` treats you as signed in with
# this role: student or admin. Leave it empty to browse signed out.
# Production builds ignore it. Restart `npm run dev` after changing it.
DEV_SESSION_ROLE=student

# Optional: the email address of the development account, for example your own
# iitk.ac.in address. You are shown by the part before the @. No password is
# used or needed; never put passwords in this file or in the repository.
DEV_SESSION_EMAIL=
