# Server-side Gemini configuration for ride recommendations and the chatbot.
# Set GEMINI_API_KEY in your local environment/deployment secret manager.
# Never put a real API key in this file or commit one to Git.
GEMINI_API_KEY=
# Shared default model for Gemini features.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional chatbot-specific model override. Defaults to GEMINI_MODEL.
GEMINI_CHATBOT_MODEL=

# Required in deployment to run post-ride payment reminders. Generate a private random secret;
# configure the scheduler to POST /api/cron/payment-reminders with Authorization: Bearer <secret>.
PAYMENT_REMINDER_CRON_SECRET=
