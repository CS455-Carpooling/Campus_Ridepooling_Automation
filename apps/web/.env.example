# Copy to .env.local in this folder (never commit .env.local).

# Development sign-in: when set, `npm run dev` treats you as signed in with
# this role (student or admin), with no database needed. Leave it empty to use
# real sign-in (needs DATABASE_URL) or to browse signed out. Production builds
# ignore it. Restart `npm run dev` after changing it.
DEV_SESSION_ROLE=student

# Optional: the email address of the development account, for example your own
# iitk.ac.in address. You are shown by the part before the @. No password is
# used or needed; never put passwords in this file or in the repository.
DEV_SESSION_EMAIL=

# Backend (see setup.md). Leave DATABASE_URL empty to run without a database:
# pages still work, and sign-in uses the development session above.
DATABASE_URL=
APP_URL=http://localhost:3000
# Mail relay for verification and reset emails. Without them, emails are
# printed to the dev server console instead.
MAIL_SCRIPT_URL=
MAIL_SCRIPT_SECRET=
