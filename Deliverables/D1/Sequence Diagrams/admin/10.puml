@startuml
hide footbox
skinparam sequenceMessageAlign center

actor "Operations Admin" as Admin
participant "Admin Dashboard" as UI
participant "Audit Service" as Backend
participant "DB: Platform-DB" as DB
participant "AS: Authorization" as Auth

Admin -> UI: View AI Decision History (ComplaintID)
activate UI
UI -> Backend: getAIDecisionHistory(ComplaintID)
activate Backend

Backend -> Auth: authorize(AdminID, Role="OperationsAdmin")
activate Auth
Auth --> Backend: authorization result
deactivate Auth

alt authorization OK
    note over Backend, DB: SYS-FR-38: Retrieve AI recommendation and final Admin decision log
    Backend -> DB: queryAIDecisionHistory(ComplaintID)
    activate DB
    DB --> Backend: AIDecisionRecord (AIRecommendation, AdminDecision, FinalAction, Timestamp)
    deactivate DB
    
    note over Backend, UI: SYS-NFR-07: Sensitive AI enforcement data restricted to authorized Admin
    Backend --> UI: Message (AIDecisionRecord)
    UI --> Admin: Display AI recommendation vs. final Admin decision
    
else authorization fail
    note over Backend: SYS-NFR-03: Server-side authorization enforced
    Backend --> UI: Error (Unauthorized)
    UI --> Admin: Display access denied
end

deactivate Backend
deactivate UI
@enduml