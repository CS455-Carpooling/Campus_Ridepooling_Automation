# Settings for docker-compose.yml. Copy this file to .env in the same folder
# (never commit .env). For `npm run dev` settings, see apps/web/.env.example.

# Password of the local PostgreSQL database. Pick your own; letters and digits
# only, because it is also used inside the database URL.
POSTGRES_PASSWORD=

# Address the app is opened at; used in the links of verification and reset
# emails.
APP_URL=http://localhost:3000

# Mail relay for verification and reset emails (see apps/web/setup.md). Without
# it no email is sent, and accounts have to be verified by hand (see README.md).
MAIL_SCRIPT_URL=
MAIL_SCRIPT_SECRET=
